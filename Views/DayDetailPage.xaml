<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DailyExpenseTracker"
             x:Class="DailyExpenseTracker.DayDetailPage"
             Title="{local:T 'দিনের খরচ'}">
    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,24" Spacing="12">

            <!-- Top card: day -->
            <Border StrokeThickness="0" Padding="10,14">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24" />
                </Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00A896" Offset="0" />
                        <GradientStop Color="#00695C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button x:Name="PrevBtn" Grid.Column="0" Text="◀" BackgroundColor="Transparent" TextColor="White"
                                FontSize="20" WidthRequest="52" Clicked="OnPrevDay" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="DayLabel" TextColor="#CFF3EE" FontSize="14" HorizontalTextAlignment="Center" />
                            <Label x:Name="TotalLabel" TextColor="White" FontSize="34" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <Button x:Name="NextBtn" Grid.Column="2" Text="▶" BackgroundColor="Transparent" TextColor="White"
                                FontSize="20" WidthRequest="52" Clicked="OnNextDay" />
                    </Grid>
                    <ContentView x:Name="BarHost" Margin="10,0" />
                    <Label x:Name="StatusLabel" TextColor="White" FontSize="14" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" Margin="10,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Per-category totals -->
            <FlexLayout x:Name="ChipsBox" Wrap="Wrap" Direction="Row" />

            <Label x:Name="ListTitle" Text="{local:T 'এন্ট্রি'}" StyleClass="H2" Margin="0,4,0,0" />
            <Label x:Name="ListHint" Text="{local:T 'কার্ডে ট্যাপ করে এডিট বা মুছুন'}" StyleClass="Muted" />
            <VerticalStackLayout x:Name="EntriesStack" Spacing="8" />

            <Button Text="{local:T '+ এই দিনে খরচ যোগ করুন'}" HeightRequest="50" Margin="0,10,0,0" Clicked="OnAdd" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
