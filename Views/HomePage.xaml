<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DailyExpenseTracker"
             x:Class="DailyExpenseTracker.HomePage"
             Title="{local:T 'পকেটনামা'}">
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,14,16,8" Spacing="14">

                <Border x:Name="TodayCard" StrokeThickness="0" Padding="20,18">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#00A896" Offset="0" />
                            <GradientStop Color="#00695C" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTodayCardTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="DateLabel" TextColor="#CFF3EE" FontSize="14" />
                        <Label Text="{local:T 'আজকের খরচ'}" TextColor="White" FontSize="15" Margin="0,6,0,0" />
                        <Label x:Name="TodaySpentLabel" TextColor="White" FontSize="36" FontAttributes="Bold" />
                        <ContentView x:Name="TodayBarHost" Margin="0,8,0,4" />
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                <Label x:Name="TodayLeftTitle" TextColor="White" FontSize="14" />
                                <Label x:Name="TodayLimitInfo" TextColor="#CFF3EE" FontSize="12" />
                            </VerticalStackLayout>
                            <Label x:Name="TodayLeftLabel" Grid.Column="1" TextColor="White"
                                   FontSize="22" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="MonthCard" Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMonthCardTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label x:Name="MonthTitleLabel" Text="{local:T 'এই মাসে খরচ'}" StyleClass="Muted" />
                                <Label x:Name="MonthSpentLabel" StyleClass="Big" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                <Label x:Name="MonthLeftTitle" StyleClass="Muted" HorizontalTextAlignment="End" />
                                <Label x:Name="MonthLeftLabel" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                        </Grid>
                        <ContentView x:Name="MonthBarHost" />
                        <Label x:Name="MonthLimitInfo" StyleClass="Muted" />
                        <Button x:Name="RangeBtn" StyleClass="Outline" HeightRequest="40" FontSize="14" Clicked="OnRangeClicked" />
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="WeekCard" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{local:T 'শেষ ৭ দিন'}" StyleClass="H2" />
                        <Grid x:Name="WeekChart" ColumnSpacing="6" />
                        <Label x:Name="WeekHint" StyleClass="Muted" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="LedgerTitle" Text="{local:T 'দিনের হিসাব'}" StyleClass="H2" Margin="0,6,0,0" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Grid Grid.Column="0" WidthRequest="124" HeightRequest="124">
                                <ContentView x:Name="RingHost" />
                                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                                    <Label x:Name="RingPct" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                    <Label x:Name="RingSub" StyleClass="Muted" FontSize="12" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label x:Name="RingLimitLabel" StyleClass="Muted" />
                                <Label x:Name="RingSpentLabel" FontSize="15" />
                                <Label x:Name="RingLeftLabel" FontSize="18" FontAttributes="Bold" />
                                <Label x:Name="RingDaysLabel" StyleClass="Muted" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource LineColor}" />
                        <Label x:Name="SoFarLabel" FontSize="15" FontAttributes="Bold" />
                        <Border x:Name="AdviceBox" StrokeThickness="0" Padding="12,10" IsVisible="False">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                            <Label x:Name="AdviceLabel" FontSize="14" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="LedgerCard" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{local:T 'দিন ধরে জমা ও বাড়তি'}" StyleClass="H2" />
                        <Label Text="{local:T 'সবুজ ডানে = লিমিট থেকে কম খরচ (টাকা বেঁচেছে), লাল বামে = বেশি খরচ। আগের দিনের হিসাব দেখে আজ কম/বেশি করুন।'}" StyleClass="Muted" FontSize="12" />
                        <VerticalStackLayout x:Name="LedgerStack" Spacing="10" />
                        <Button x:Name="MoreBtn" Text="{local:T 'সব দিনের হিসাব দেখুন ›'}" StyleClass="Ghost" FontSize="14" HeightRequest="40" Clicked="OnMoreClicked" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{local:T 'পকেটনামা'}" StyleClass="H2" Margin="0,6,0,0" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout x:Name="BreakdownStack" Spacing="10" />
                </Border>

                <Label Text="{local:T 'আজকের এন্ট্রি'}" StyleClass="H2" Margin="0,6,0,0" />
                <Label Text="{local:T 'ভুল হলে এন্ট্রিতে ট্যাপ করে এডিট করুন'}" StyleClass="Muted" />
                <VerticalStackLayout x:Name="EntriesStack" Spacing="8" />
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1" Text="{local:T '+ খরচ যোগ করুন'}" HeightRequest="54" Margin="16,8,16,12" Clicked="OnAddClicked" />
    </Grid>
</ContentPage>
