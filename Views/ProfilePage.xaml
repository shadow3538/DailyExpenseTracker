<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DailyExpenseTracker"
             x:Class="DailyExpenseTracker.ProfilePage"
             Title="{local:T 'আমার প্রোফাইল'}">
    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,28" Spacing="12">

            <!-- Photo + name -->
            <Border StrokeThickness="0" Padding="20,22">
                <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#00A896" Offset="0" />
                        <GradientStop Color="#00695C" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                    <ContentView x:Name="AvatarHost" HorizontalOptions="Center" />
                    <Label x:Name="NameLabel" TextColor="White" FontSize="22" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" Margin="0,8,0,0" />
                    <Label x:Name="SubLabel" TextColor="#CFF3EE" FontSize="14" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Stats -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8,12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="CountLabel" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="{local:T 'মোট এন্ট্রি'}" StyleClass="Muted" FontSize="12" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="8,12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="TotalLabel" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                        <Label Text="{local:T 'মোট খরচ'}" StyleClass="Muted" FontSize="12" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8,12">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="SinceLabel" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="{local:T 'হিসাব শুরু'}" StyleClass="Muted" FontSize="12" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- About -->
            <Border x:Name="BioCard" Style="{StaticResource Card}" IsVisible="False">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{local:T 'আমার সম্পর্কে'}" StyleClass="Muted" />
                    <Label x:Name="BioLabel" FontSize="15" />
                </VerticalStackLayout>
            </Border>

            <!-- Personal info -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout x:Name="InfoStack" Spacing="14" />
            </Border>

            <Button Text="{local:T '✎ প্রোফাইল এডিট করুন'}" HeightRequest="52" Clicked="OnEdit" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
