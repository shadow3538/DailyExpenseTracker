<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DailyExpenseTracker"
             x:Class="DailyExpenseTracker.SettingsPage"
             Title="{local:T 'সেটিংস'}">
    <ScrollView>
        <VerticalStackLayout Padding="18,16,18,30" Spacing="10">

            <Border Style="{StaticResource Card}" Padding="14,14">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <ContentView x:Name="AvatarHost" Grid.Column="0" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="ProfNameLabel" FontSize="19" FontAttributes="Bold" />
                            <Label x:Name="ProfSubLabel" StyleClass="Muted" />
                        </VerticalStackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnViewProfile" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="{local:T 'আমার প্রোফাইল'}" StyleClass="Outline" HeightRequest="42" FontSize="14" Clicked="OnViewProfile" />
                        <Button Grid.Column="1" Text="{local:T '✎ প্রোফাইল এডিট'}" HeightRequest="42" FontSize="14" Clicked="OnEditProfile" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="FinanceHost" Spacing="10" Margin="0,4,0,0" />

            <VerticalStackLayout x:Name="PrefHost" Spacing="10" Margin="0,6,0,0" />

            <VerticalStackLayout x:Name="CatHost" Margin="0,10,0,0" />
            <Label Text="{local:T 'খরচ যোগ করার সময় আগে ক্যাটাগরি বাছবেন। \'অপশন\' ক্যাটাগরিতে ভিতর থেকে বেছে নেবেন (যেমন খাওয়া → দুপুর); \'লেখা\' ক্যাটাগরিতে কী কিনলেন নিজে লিখবেন (যেমন কেনাকাটা)। নাম বদলালে আগের হিসাবেও বদলায়; মুছলে আগের হিসাব মুছবে না।'}" StyleClass="Muted" FontSize="12" Margin="4,0,4,0" />

            <VerticalStackLayout x:Name="BackupHost" Margin="0,10,0,0" />
            <Label x:Name="BackupNote" StyleClass="Muted" FontSize="12" Margin="4,0,4,0" />

            <VerticalStackLayout x:Name="DownloadHost" Margin="0,10,0,0" />

            <VerticalStackLayout x:Name="AboutHost" Spacing="10" Margin="0,14,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
